+// Opt-in disposable LOCAL OpenStack test. HTTP listens only inside the VM;
+// the sole access path is production SSHForwarder/direct-tcpip. No Gateway,
+// SaaS or KT Cloud acceptance is implied. Teardown uses exact tracked IDs.
+func TestOpenStackPreviewForwardingIntegration(t *testing.T) {
+	if os.Getenv("LABBIT_OPENSTACK_PREVIEW_TEST") != "1" {
+		t.Skip("set LABBIT_OPENSTACK_PREVIEW_TEST=1 for disposable local OpenStack forwarding acceptance")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 14*time.Minute)
+	defer cancel()
+	a, err := New(ctx, ConfigFromEnvironment())
+	if err != nil {
+		t.Fatal("Provider initialization failed")
+	}
+	images, err := a.ListImages(ctx)
+	if err != nil {
+		t.Fatal("image discovery failed")
+	}
+	flavors, err := a.ListFlavors(ctx)
+	if err != nil {
+		t.Fatal("flavor discovery failed")
+	}
+	networks, err := a.ListNetworks(ctx)
+	if err != nil {
+		t.Fatal("network discovery failed")
+	}
+	image := exactImage(t, images, environmentOrDefault("LABBIT_OPENSTACK_TEST_IMAGE", "ubuntu"))
+	flavor := exactFlavor(t, flavors, environmentOrDefault("LABBIT_OPENSTACK_TEST_FLAVOR", "m1.small"))
+	management := exactNetwork(t, networks, environmentOrDefault("LABBIT_OPENSTACK_TEST_MANAGEMENT_NETWORK", "sharednet1"))
+	keyFile := a.provision.SSHPrivateKeyFile
+	keypair := integrationKeyPairName(t, ctx, a, keyFile)
+	allowed := environmentOrDefault("LABBIT_OPENSTACK_TEST_SSH_CIDR", "172.16.8.1/32")
+	sg := integrationManagementSecurityGroup(t, ctx, a, allowed)
+	a.provision = normalizedProvisionConfig(ProvisionConfig{
+		ProviderConnectionID: "local-integration", ProjectID: integrationProjectID(t, a),
+		ManagementNetworkID: management.ID, ManagementSecurityGroupID: sg,
+		KeyPairName: keypair, SSHAllowedCIDR: allowed,
+		LabSubnetCIDR: environmentOrDefault("LABBIT_OPENSTACK_TEST_LAB_CIDR", "198.20.0.0/24"),
+		SSHUsername:   a.provision.SSHUsername, SSHPrivateKeyFile: keyFile,
+		SSHKnownHostsFile: t.TempDir() + "/known_hosts", PollInterval: 2 * time.Second,
+	})
+	snapshot := coreprovider.CreationSnapshot{ProviderConnectionID: "local-integration", WorkspaceVMKey: "workspace",
+		VMs: []coreprovider.VMSpec{{VMKey: "workspace", Role: "WORKSPACE", ImageID: image.ID, FlavorID: flavor.ID,
+			FlavorSpec: coreprovider.FlavorSpec{VCPUs: flavor.VCPUs, RAMMiB: flavor.RAMMiB, DiskGiB: flavor.DiskGiB}}}}
+	labID := "lbt173-" + integrationRunID(t)
+	var tracked []coreprovider.ResourceResult
+	t.Cleanup(func() {
+		cleanupM2Resources(t, a, tracked)
+		t.Logf("Exact tracked VM/network/port/SG absence verified after cleanup: resources=%d", len(tracked))
+	})
+	created, err := a.Provision(ctx, coreprovider.ProvisionRequest{
+		Correlation: coreprovider.Correlation{OperationID: labID + "-provision", LabInstanceID: labID, Generation: 1}, CreationSnapshot: snapshot,
+	})
+	tracked = append(tracked, created.ProviderResources...)
+	if err != nil || created.Outcome != coreprovider.OutcomeSucceeded {
+		t.Fatal("disposable Workspace Provision failed")
+	}
+	t.Log("Local OpenStack Workspace ACTIVE, authenticated SSH ready and host key enrolled")
+	target := vmaccess.Target{LabInstanceID: labID, Generation: 1, VMKey: "workspace", ServerID: providerResourceID(t, created.ProviderResources, coreprovider.ResourceTypeServer, "workspace")}
+	access := vmaccess.NewManager(a, vmaccess.Config{IdleTimeout: 100 * time.Millisecond})
+	defer access.Close()
+	forwarder := &preview.SSHForwarder{Access: access, Validator: a}
+	server := realOpenSession(t, ctx, access, target)
+	defer server.Close()
+	var stdout io.Reader
+	if err := server.Setup(ctx, func(raw *ssh.Session) error {
+		var err error
+		stdout, err = raw.StdoutPipe()
+		if err != nil {
+			return err
+		}
+		raw.Stderr = io.Discard
+		return raw.Start("exec python3 -u -c 'from http.server import BaseHTTPRequestHandler, HTTPServer; exec(\"class Handler(BaseHTTPRequestHandler):\\n def do_GET(self):\\n  body=b\\\"LBT173-HTTP-OK\\\"; self.send_response(200); self.send_header(\\\"Content-Length\\\",str(len(body))); self.end_headers(); self.wfile.write(body)\\n def log_message(self,*args): pass\"); server=HTTPServer((\"127.0.0.1\",3000),Handler); print(\"READY\",flush=True); server.serve_forever()'")
+	}); err != nil {
+		t.Fatal("HTTP fixture setup failed")
+	}
+	ready := make(chan bool, 1)
+	go func() {
+		line, err := bufio.NewReader(stdout).ReadString('\n')
+		ready <- err == nil && line == "READY\n"
+	}()
+	select {
+	case ok := <-ready:
+		if !ok {
+			t.Fatal("HTTP fixture did not start")
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatal("HTTP fixture startup timed out")
+	}
+	pty, err := terminal.NewManagedSSHPTY(ctx, access, target, 80, 24)
+	if err != nil {
+		t.Fatal("sibling PTY setup failed")
+	}
+	defer pty.Close()
+	sftp, fileSession := workspaceFixtureSFTP(t, ctx, access, target)
+	defer fileSession.Close()
+	defer sftp.Close()
+	identity := realSSHConnection(t, ctx, access, target)
+	for range 2 {
+		conn, err := forwarder.DialTCP(ctx, target, 3000)
+		if err != nil {
+			t.Fatalf("SSH forwarding failed: %v", err)
+		}
+		func() {
+			defer conn.Close()
+			// Bound a stalled fixture response through the managed stream Close.
+			stop := time.AfterFunc(10*time.Second, func() { _ = conn.Close() })
+			defer stop.Stop()
+			if _, err := fmt.Fprint(conn, "GET / HTTP/1.1\r\nHost: fixture\r\nConnection: close\r\n\r\n"); err != nil {
+				t.Fatal("forwarded HTTP write failed")
+			}
+			response, err := http.ReadResponse(bufio.NewReader(conn), nil)
+			if err != nil {
+				t.Fatal("forwarded HTTP read failed")
+			}
+			defer response.Body.Close()
+			body, err := io.ReadAll(io.LimitReader(response.Body, 128))
+			if err != nil || response.StatusCode != 200 || string(body) != "LBT173-HTTP-OK" {
+				t.Fatal("forwarded HTTP response mismatch")
+			}
+		}()
+	}
+	if identity != realSSHConnection(t, ctx, access, target) {
+		t.Fatal("Preview replaced shared SSH transport")
+	}
+	if _, err := pty.Write([]byte("printf 'LBT147-%s\\n' 'PTY-OK'\n")); err != nil {
+		t.Fatal("sibling PTY write failed")
+	}
+	assertPTYMarker(t, pty)
+	if _, err := sftp.Stat("."); err != nil {
+		t.Fatal("sibling SFTP broken after Preview close")
+	}
+	t.Log("SSH direct-tcpip loopback:3000 HTTP 200 exact body twice; same SSH transport; PTY and SFTP survive Preview close PASS")
+	for _, bad := range []vmaccess.Target{
+		{LabInstanceID: "wrong", Generation: 1, VMKey: target.VMKey, ServerID: target.ServerID},
+		{LabInstanceID: labID, Generation: 2, VMKey: target.VMKey, ServerID: target.ServerID},
+		{LabInstanceID: labID, Generation: 1, VMKey: "other", ServerID: target.ServerID},
+		{LabInstanceID: labID, Generation: 1, VMKey: target.VMKey, ServerID: "missing-server"},
+	} {
+		if _, err := forwarder.DialTCP(ctx, bad, 3000); !errors.Is(err, preview.ErrVMUnreachable) {
+			t.Fatal("invalid real Provider target accepted")
+		}
+	}
+	for _, port := range []int{-1, 0, 22, 65536} {
+		if _, err := forwarder.DialTCP(ctx, target, port); !errors.Is(err, preview.ErrPortRejected) {
+			t.Fatal("unsafe Preview port accepted")
+		}
+	}
+	if _, err := forwarder.DialTCP(ctx, target, 3001); !errors.Is(err, preview.ErrAppNotRunning) {
+		t.Fatal("closed application port not classified")
+	}
+	t.Log("Wrong LabInstance/generation/VM/server rejected; invalid/22 ports rejected; real closed app port -> APP_NOT_RUNNING PASS")
+	// Actual reset supplies a positive older generation and a replaced Server ID.
+	_ = sftp.Close()
+	_ = fileSession.Close()
+	_ = pty.Close()
+	_ = server.Close()
+	access.InvalidateBefore(labID, 2)
+	reset, err := a.Reset(ctx, coreprovider.ResetRequest{Correlation: coreprovider.Correlation{OperationID: labID + "-reset", LabInstanceID: labID, Generation: 2}, CreationSnapshot: snapshot, ProviderResources: resourceRefs(created.ProviderResources, 1)})
+	tracked = append(tracked, reset.ProviderResources...)
+	if err != nil || reset.Outcome != coreprovider.OutcomeSucceeded {
+		t.Fatal("disposable Workspace Reset failed")
+	}
+	if _, err := forwarder.DialTCP(ctx, target, 3000); !errors.Is(err, preview.ErrVMUnreachable) {
+		t.Fatal("old generation target accepted after Reset")
+	}
+	newTarget := vmaccess.Target{LabInstanceID: labID, Generation: 2, VMKey: "workspace", ServerID: providerResourceID(t, resourceResultsForGeneration(reset.ProviderResources, 2), coreprovider.ResourceTypeServer, "workspace")}
+	if _, err := forwarder.DialTCP(ctx, newTarget, 3000); !errors.Is(err, preview.ErrAppNotRunning) {
+		t.Fatal("new VM was not independently reached")
+	}
+	t.Log("Real Reset gen1->gen2: stale target rejected; new VM fresh SSH and closed application port confirmed PASS")
+}
diff --git a/internal/connector/vmaccess/tcp.go b/internal/connector/vmaccess/tcp.go
new file mode 100644
index 0000000..8370813
--- /dev/null
+++ b/internal/connector/vmaccess/tcp.go
@@ -0,0 +1,145 @@
+package vmaccess
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"strings"
+	"sync"
+
+	"golang.org/x/crypto/ssh"
+)
+
+// ErrConnectionRefused distinguishes a reached VM with no listening app.
+var ErrConnectionRefused = errors.New("VM application connection refused")
+
+// Includes setup, stream pumps and channels awaiting the peer's SSH CLOSE.
+// Never accumulate unbounded channels/workers on a shared SSH transport.
+const maxTCPChannels = 16
+
+// DialTCP opens direct-tcpip to the VM's own loopback, never a supplied host.
+// Context bounds setup only; the returned connection owns its channel until
+// Close, transport failure, generation invalidation or Manager shutdown.
+func (m *Manager) DialTCP(ctx context.Context, target Target, port int) (net.Conn, error) {
+	if port < 1 || port > 65535 || port == 22 {
+		return nil, ErrInvalidTarget
+	}
+	ctx, cancel := context.WithTimeout(ctx, m.config.SetupTimeout)
+	defer cancel()
+	c, err := m.acquire(ctx, target)
+	if err != nil {
+		return nil, err
+	}
+	releaseUser := sync.OnceFunc(func() { m.release(c) })
+	result, err := m.channelOperation(ctx, c, func() channelResult {
+		// Only an actual worker reserves a slot. Waiting canceled callers
+		// never allocate one; late successes retain theirs until SSH CLOSE.
+		m.mu.Lock()
+		if ctx.Err() != nil || c.retired || c.tcpChannels >= maxTCPChannels {
+			m.mu.Unlock()
+			return channelResult{err: ErrUnavailable}
+		}
+		c.tcpChannels++
+		m.mu.Unlock()
+		// RFC 4254 section 7.2: exact loopback destination, no caller host.
+		payload := struct {
+			Destination string
+			Port        uint32
+			Origin      string
+			OriginPort  uint32
+		}{"127.0.0.1", uint32(port), "0.0.0.0", 0}
+		channel, requests, err := c.client.OpenChannel("direct-tcpip", ssh.Marshal(payload))
+		if err != nil {
+			m.releaseTCP(c)
+			return channelResult{err: err}
+		}
+		closed := make(chan struct{})
+		go func() {
+			ssh.DiscardRequests(requests)
+			close(closed) // EOF alone does not release x/crypto's channel map.
+		}()
+		// Even a late success owns its slot until pumps and SSH channel exit.
+		return channelResult{conn: m.tcpStream(c, channel, closed, port, releaseUser)}
+	})
+	if ctx.Err() != nil || err != nil || result.err != nil {
+		m.discardResult(c, result)
+		releaseUser()
+		var refused *ssh.OpenChannelError
+		if ctx.Err() == nil && err == nil && errors.As(result.err, &refused) &&
+			refused.Reason == ssh.ConnectionFailed && strings.Contains(strings.ToLower(refused.Message), "connection refused") {
+			return nil, ErrConnectionRefused
+		}
+		return nil, m.connectionError(ctx, c)
+	}
+	m.mu.Lock()
+	err = m.targetErrorLocked(target)
+	if c.retired && err == nil {
+		err = ErrUnavailable
+	}
+	m.mu.Unlock()
+	if err != nil {
+		m.discardResult(c, result)
+		releaseUser()
+		return nil, err
+	}
+	return result.conn, nil
+}
+
+func (m *Manager) releaseTCP(c *connection) {
+	m.mu.Lock()
+	c.tcpChannels--
+	m.mu.Unlock()
+}
+
+// x/crypto's channel Close cannot interrupt a local Read without a peer CLOSE.
+// The pipe gives callers local cancellation/deadlines without retiring sibling
+// channels. At most maxTCPChannels channels/pump pairs belong to this transport;
+// idle expiry, invalidation and shutdown also reap non-cooperating peers.
+func (m *Manager) tcpStream(c *connection, raw io.ReadWriteCloser, closed <-chan struct{}, port int, release func()) net.Conn {
+	caller, bridge := net.Pipe()
+	stream := &tcpConnection{Conn: caller, bridge: bridge, raw: raw, manager: m, connection: c, port: port, release: release}
+	var pumps sync.WaitGroup
+	pumps.Add(2)
+	go func() {
+		defer pumps.Done()
+		_, _ = io.Copy(raw, bridge)
+		_ = stream.Close()
+	}()
+	go func() {
+		defer pumps.Done()
+		_, _ = io.Copy(bridge, raw)
+		_ = stream.Close()
+	}()
+	go func() { pumps.Wait(); <-closed; m.releaseTCP(c) }()
+	return stream
+}
+
+type tcpConnection struct {
+	net.Conn
+	bridge     net.Conn
+	raw        io.ReadWriteCloser
+	manager    *Manager
+	connection *connection
+	port       int
+	release    func()
+	once       sync.Once
+}
+
+// Close queues potentially blocking SSH writes without closing sibling channels.
+func (c *tcpConnection) Close() error {
+	c.once.Do(func() {
+		_ = c.Conn.Close()
+		_ = c.bridge.Close()
+		c.manager.mu.Lock()
+		c.manager.closeChannelLocked(c.connection, c.raw)
+		c.manager.mu.Unlock()
+		c.release()
+	})
+	return nil
+}
+
+func (c *tcpConnection) LocalAddr() net.Addr { return &net.TCPAddr{IP: net.IPv4zero} }
+func (c *tcpConnection) RemoteAddr() net.Addr {
+	return &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1), Port: c.port}
+}
diff --git a/internal/connector/vmaccess/tcp_test.go b/internal/connector/vmaccess/tcp_test.go
new file mode 100644
index 0000000..69cd80e
--- /dev/null
+++ b/internal/connector/vmaccess/tcp_test.go
@@ -0,0 +1,311 @@
+package vmaccess
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"net"
+	"strings"
+	"testing"
+	"time"
+
+	"golang.org/x/crypto/ssh"
+)
+
+// Models an SSH channel whose peer keeps the transport alive but never
+// completes channel I/O or acknowledges CLOSE. Transport retirement ends it.
+type unresponsiveTCP struct {
+	net.Conn
+	done    <-chan struct{}
+	writing chan struct{}
+}
+
+func (c *unresponsiveTCP) Read([]byte) (int, error) { <-c.done; return 0, io.EOF }
+func (c *unresponsiveTCP) Write([]byte) (int, error) {
+	if c.writing != nil {
+		close(c.writing)
+	}
+	<-c.done
+	return 0, io.ErrClosedPipe
+}
+func (c *unresponsiveTCP) Close() error { return nil }
+
+func TestTCPEOFDoesNotReleaseChannelBudgetBeforeSSHClose(t *testing.T) {
+	p := newSSHPeer(t)
+	m := testManager(t, p, Config{})
+	pty := openSession(t, m, testTarget())
+	in, out := echoChannel(t, pty, false)
+	var transport *connection
+	for range maxTCPChannels {
+		c, err := m.acquire(context.Background(), testTarget())
+		if err != nil {
+			t.Fatal(err)
+		}
+		transport = c
+		m.mu.Lock()
+		c.tcpChannels++
+		m.mu.Unlock()
+		raw, peer := net.Pipe()
+		stream := m.tcpStream(c, raw, c.done, 8080, func() { m.release(c) })
+		_ = peer.Close() // Data EOF, but no SSH CLOSE until transport shutdown.
+		if _, err := stream.Read(make([]byte, 1)); err == nil {
+			t.Fatal("EOF did not terminate caller stream")
+		}
+	}
+	if _, err := m.DialTCP(context.Background(), testTarget(), 8080); !errors.Is(err, ErrUnavailable) {
+		t.Fatal("EOF-only channels escaped transport channel budget")
+	}
+	assertEcho(t, in, out)
+	_ = m.Close()
+	eventually(t, func() bool {
+		m.mu.Lock()
+		defer m.mu.Unlock()
+		return transport.tcpChannels == 0
+	})
+}
+
+func TestTCPCloseUnblocksCallersAndBoundsNonCooperatingPeer(t *testing.T) {
+	p := newSSHPeer(t)
+	m := testManager(t, p, Config{IdleTimeout: 30 * time.Millisecond})
+	pty := openSession(t, m, testTarget())
+	in, out := echoChannel(t, pty, false)
+	var transport *connection
+	for range maxTCPChannels {
+		c, err := m.acquire(context.Background(), testTarget())
+		if err != nil {
+			t.Fatal(err)
+		}
+		transport = c
+		m.mu.Lock()
+		c.tcpChannels++
+		m.mu.Unlock()
+		raw := &unresponsiveTCP{done: c.done, writing: make(chan struct{})}
+		stream := m.tcpStream(c, raw, c.done, 8080, func() { m.release(c) })
+		reading, writing := make(chan error, 1), make(chan error, 1)
+		go func() { _, err := stream.Read(make([]byte, 1)); reading <- err }()
+		go func() { _, err := stream.Write(bytes.Repeat([]byte{'x'}, 65536)); writing <- err }()
+		select {
+		case <-raw.writing:
+		case <-time.After(time.Second):
+			t.Fatal("raw write not started")
+		}
+		_ = stream.Close()
+		for _, done := range []chan error{reading, writing} {
+			select {
+			case err := <-done:
+				if err == nil {
+					t.Fatal("closed caller I/O succeeded")
+				}
+			case <-time.After(time.Second):
+				t.Fatal("Close did not interrupt caller I/O")
+			}
+		}
+	}
+	if _, err := m.DialTCP(context.Background(), testTarget(), 8080); !errors.Is(err, ErrUnavailable) {
+		t.Fatal("lingering pumps escaped per-transport budget")
+	}
+	assertEcho(t, in, out)
+	if p.accepted.Load() != 1 {
+		t.Fatal("budget exhaustion replaced sibling transport")
+	}
+	_ = pty.Close()
+	eventually(t, func() bool {
+		m.mu.Lock()
+		defer m.mu.Unlock()
+		return transport.retired && transport.tcpChannels == 0
+	})
+	eventually(t, func() bool { return p.active.Load() == 0 })
+}
+
+func TestTCPSSHUnavailableAndHostPinFailureAreSafe(t *testing.T) {
+	for _, mode := range []string{"pin", "offline"} {
+		t.Run(mode, func(t *testing.T) {
+			p := newSSHPeer(t)
+			if mode == "pin" {
+				p.endpoint.HostKeyCallback = func(string, net.Addr, ssh.PublicKey) error { return errors.New("private host key mismatch") }
+			} else {
+				_ = p.listener.Close()
+			}
+			m := testManager(t, p, Config{})
+			if _, err := m.DialTCP(context.Background(), testTarget(), 8080); !errors.Is(err, ErrUnavailable) || strings.Contains(err.Error(), "private") {
+				t.Fatalf("SSH failure not sanitized: %v", err)
+			}
+		})
+	}
+}
+
+func TestTCPSharedTransportExactDestinationAndIsolation(t *testing.T) {
+	p := newSSHPeer(t)
+	m := testManager(t, p, Config{IdleTimeout: 50 * time.Millisecond})
+	pty := openSession(t, m, testTarget())
+	file := openSession(t, m, testTarget())
+	ptyIn, ptyOut := echoChannel(t, pty, false)
+	fileIn, fileOut := echoChannel(t, file, true)
+	ctx, cancel := context.WithCancel(context.Background())
+	tcp, err := m.DialTCP(ctx, testTarget(), 5000)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tcp.Close()
+	cancel() // Setup context does not own an established stream.
+	request := <-p.forwarded
+	if request.Host != "127.0.0.1" || request.Port != 5000 {
+		t.Fatal("wrong SSH destination")
+	}
+	assertEcho(t, tcp, tcp)
+	if p.accepted.Load() != 1 {
+		t.Fatal("TCP did not share PTY/SFTP transport")
+	}
+	_ = tcp.Close()
+	_ = tcp.Close()
+	assertEcho(t, ptyIn, ptyOut)
+	assertEcho(t, fileIn, fileOut)
+	other, err := m.DialTCP(context.Background(), testTarget(), 80)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer other.Close()
+	_ = pty.Close()
+	_ = file.Close()
+	assertEcho(t, other, other)
+	_ = other.Close()
+	eventually(t, func() bool { return p.active.Load() == 0 })
+}
+
+func TestTCPValidationAndSafeErrors(t *testing.T) {
+	p := newSSHPeer(t)
+	var resolved int
+	m := NewManager(resolverFunc(func(_ context.Context, target Target) (Endpoint, error) {
+		resolved++
+		if target != testTarget() {
+			return Endpoint{}, ErrInvalidTarget
+		}
+		return p.endpoint, nil
+	}), Config{})
+	defer m.Close()
+	for _, port := range []int{-1, 0, 22, 65536} {
+		if _, err := m.DialTCP(context.Background(), testTarget(), port); !errors.Is(err, ErrInvalidTarget) {
+			t.Fatal("invalid port accepted")
+		}
+	}
+	if resolved != 0 {
+		t.Fatal("rejected port reached resolver")
+	}
+	for _, target := range []Target{
+		{LabInstanceID: "other", Generation: 1, VMKey: "workspace", ServerID: "server-1"},
+		{LabInstanceID: "lab-1", Generation: 2, VMKey: "workspace", ServerID: "server-1"},
+		{LabInstanceID: "lab-1", Generation: 1, VMKey: "other", ServerID: "server-1"},
+		{LabInstanceID: "lab-1", Generation: 1, VMKey: "workspace", ServerID: "other"},
+	} {
+		if _, err := m.DialTCP(context.Background(), target, 8080); !errors.Is(err, ErrInvalidTarget) {
+			t.Fatal("wrong target accepted")
+		}
+	}
+	for mode, expected := range map[int64]error{1: ErrConnectionRefused, 2: ErrUnavailable} {
+		p.rejectTCP.Store(mode)
+		_, err := m.DialTCP(context.Background(), testTarget(), 8080)
+		if !errors.Is(err, expected) || strings.Contains(err.Error(), "private") {
+			t.Fatalf("unsafe or incorrect error: %v", err)
+		}
+	}
+	p.rejectTCP.Store(0)
+	tcp, err := m.DialTCP(context.Background(), testTarget(), 8080)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tcp.Close()
+	m.InvalidateBefore("lab-1", 2)
+	if _, err := m.DialTCP(context.Background(), testTarget(), 8080); !errors.Is(err, ErrInvalidTarget) {
+		t.Fatal("stale generation accepted")
+	}
+	if _, err := tcp.Read(make([]byte, 1)); err == nil {
+		t.Fatal("invalidated stream still active")
+	}
+}
+
+func TestTCPOpenTimeoutLateChannelAndSiblingIsolation(t *testing.T) {
+	p := newSSHPeer(t)
+	m := testManager(t, p, Config{SetupTimeout: 40 * time.Millisecond, IdleTimeout: 50 * time.Millisecond})
+	pty := openSession(t, m, testTarget())
+	in, out := echoChannel(t, pty, false)
+	p.stallOpen.Store(true)
+	_, err := m.DialTCP(context.Background(), testTarget(), 8080)
+	if !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("timeout not classified: %v", err)
+	}
+	late := <-p.heldOpen
+	m.mu.Lock()
+	pending := m.entries[testTarget()].tcpChannels
+	m.mu.Unlock()
+	if pending != 1 {
+		t.Fatal("timed-out in-flight open lost its transport slot")
+	}
+	for range 4 {
+		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Millisecond)
+		_, err := m.DialTCP(ctx, testTarget(), 8080)
+		cancel()
+		if !errors.Is(err, context.DeadlineExceeded) {
+			t.Fatalf("waiter timeout: %v", err)
+		}
+	}
+	if p.openCount.Load() != 2 {
+		t.Fatal("canceled waiters started unbounded channel workers")
+	}
+	assertEcho(t, in, out)
+	p.stallOpen.Store(false)
+	channel, requests, err := late.Accept()
+	if err != nil {
+		t.Fatal(err)
+	}
+	go ssh.DiscardRequests(requests)
+	closed := make(chan struct{})
+	go func() { _, _ = io.Copy(io.Discard, channel); _ = channel.Close(); close(closed) }()
+	select {
+	case <-closed:
+	case <-time.After(time.Second):
+		t.Fatal("late successful channel leaked")
+	}
+	eventually(t, func() bool {
+		m.mu.Lock()
+		defer m.mu.Unlock()
+		return m.entries[testTarget()].tcpChannels == 0
+	})
+	assertEcho(t, in, out)
+	tcp, err := m.DialTCP(context.Background(), testTarget(), 8080)
+	if err != nil {
+		t.Fatal(err)
+	}
+	assertEcho(t, tcp, tcp)
+	_ = tcp.Close()
+	_ = pty.Close()
+	eventually(t, func() bool { return p.active.Load() == 0 })
+}
+
+func TestTCPCancelAndShutdownPendingOpen(t *testing.T) {
+	p := newSSHPeer(t)
+	m := testManager(t, p, Config{})
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := m.DialTCP(ctx, testTarget(), 8080); !errors.Is(err, context.Canceled) {
+		t.Fatalf("canceled dial: %v", err)
+	}
+	p.stallOpen.Store(true)
+	done := make(chan error, 1)
+	go func() { _, err := m.DialTCP(context.Background(), testTarget(), 8080); done <- err }()
+	select {
+	case <-p.heldOpen:
+	case <-time.After(time.Second):
+		t.Fatal("open not started")
+	}
+	_ = m.Close()
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("shutdown dial succeeded")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("shutdown did not unblock dial")
+	}
+	eventually(t, func() bool { return p.active.Load() == 0 })
+}
diff --git a/tools/ktcloud-d1-acceptance/preview.go b/tools/ktcloud-d1-acceptance/preview.go
new file mode 100644
index 0000000..10071ac
--- /dev/null
+++ b/tools/ktcloud-d1-acceptance/preview.go
@@ -0,0 +1,247 @@
+package main
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"time"
+
+	"github.com/ktcloud4-SL/labbit-app/internal/connector/preview"
+	"github.com/ktcloud4-SL/labbit-app/internal/connector/protocol"
+	openstackprovider "github.com/ktcloud4-SL/labbit-app/internal/connector/provider/openstack"
+	"github.com/ktcloud4-SL/labbit-app/internal/connector/terminal"
+	"github.com/ktcloud4-SL/labbit-app/internal/connector/vmaccess"
+	"github.com/pkg/sftp"
+	"golang.org/x/crypto/ssh"
+)
+
+// Fixture-only selection. Preview Data WSS and Browser acceptance are separate.
+func validatePreviewScope(enabled, op02 bool, generations int, recovery bool) error {
+	if enabled && (op02 || generations != 2 || recovery) {
+		return errors.New("Preview smoke requires a fresh exclusive two-generation fixture")
+	}
+	return nil
+}
+
+func requirePreviewCapability(raw []byte) error {
+	var hello struct {
+		Payload struct {
+			Capabilities []string `json:"capabilities"`
+		} `json:"payload"`
+	}
+	if json.Unmarshal(raw, &hello) != nil {
+		return errors.New("Preview capability HELLO malformed")
+	}
+	for _, capability := range hello.Payload.Capabilities {
+		if capability == protocol.CapabilityPreviewV1 {
+			return nil
+		}
+	}
+	return errors.New("Production Connector did not advertise preview-v1")
+}
+
+// Uses the production SSHForwarder/VMAccess on the actual KT Connector host.
+// Provider mutations remain exclusively in the existing journaled Control path.
+func provePreviewForwarding(ctx context.Context, resources []protocol.ProviderResourceRef, generation int64, oldServer string) error {
+	ctx, cancel := context.WithTimeout(ctx, 3*time.Minute)
+	defer cancel()
+	adapter, err := openstackprovider.New(ctx, openstackprovider.ConfigFromEnvironment())
+	if err != nil {
+		return errors.New("Preview fixture Provider initialization failed")
+	}
+	access := vmaccess.NewManager(adapter, vmaccess.Config{})
+	defer access.Close()
+	stopClose := context.AfterFunc(ctx, func() { _ = access.Close() })
+	defer stopClose()
+	target := vmaccess.Target{LabInstanceID: journal.LabID, Generation: generation, VMKey: "workspace", ServerID: serverRef(resources)}
+	forwarder := &preview.SSHForwarder{Access: access, Validator: adapter}
+	server, err := access.OpenSession(ctx, target)
+	if err != nil {
+		return errors.New("Preview HTTP fixture pinned SSH unavailable")
+	}
+	defer server.Close()
+	var stdout io.Reader
+	err = server.Setup(ctx, func(raw *ssh.Session) error {
+		var err error
+		stdout, err = raw.StdoutPipe()
+		if err != nil {
+			return err
+		}
+		raw.Stderr = io.Discard
+		return raw.Start("exec python3 -u -c 'from http.server import BaseHTTPRequestHandler, HTTPServer; exec(\"class Handler(BaseHTTPRequestHandler):\\n def do_GET(self):\\n  body=b\\\"LBT173-HTTP-OK\\\"; self.send_response(200); self.send_header(\\\"Content-Length\\\",str(len(body))); self.end_headers(); self.wfile.write(body)\\n def log_message(self,*args): pass\"); server=HTTPServer((\"127.0.0.1\",3000),Handler); print(\"READY\",flush=True); server.serve_forever()'")
+	})
+	if err != nil {
+		return errors.New("Preview HTTP fixture setup failed")
+	}
+	ready := make(chan bool, 1)
+	go func() {
+		line, err := bufio.NewReader(stdout).ReadString('\n')
+		ready <- err == nil && line == "READY\n"
+	}()
+	select {
+	case ok := <-ready:
+		if !ok {
+			return errors.New("Preview HTTP fixture did not start")
+		}
+	case <-ctx.Done():
+		return errors.New("Preview HTTP fixture timed out")
+	}
+	pty, err := terminal.NewManagedSSHPTY(ctx, access, target, 80, 24)
+	if err != nil {
+		return errors.New("Preview sibling PTY setup failed")
+	}
+	defer pty.Close()
+	file, err := access.OpenSession(ctx, target)
+	if err != nil {
+		return errors.New("Preview sibling SFTP SSH setup failed")
+	}
+	defer file.Close()
+	var in io.WriteCloser
+	var out io.Reader
+	err = file.Setup(ctx, func(raw *ssh.Session) error {
+		var err error
+		in, err = raw.StdinPipe()
+		if err != nil {
+			return err
+		}
+		out, err = raw.StdoutPipe()
+		if err != nil {
+			return err
+		}
+		raw.Stderr = io.Discard
+		return raw.RequestSubsystem("sftp")
+	})
+	if err != nil {
+		return errors.New("Preview sibling SFTP subsystem failed")
+	}
+	client, err := sftp.NewClientPipe(out, in)
+	if err != nil {
+		return errors.New("Preview sibling SFTP initialization failed")
+	}
+	defer client.Close()
+	identity, err := previewSSHIdentity(ctx, access, target)
+	if err != nil {
+		return err
+	}
+	for range 2 {
+		conn, err := forwarder.DialTCP(ctx, target, 3000)
+		if err != nil {
+			return errors.New("KT SSH Preview forwarding failed")
+		}
+		err = checkPreviewHTTP(conn)
+		_ = conn.Close()
+		if err != nil {
+			return err
+		}
+	}
+	after, err := previewSSHIdentity(ctx, access, target)
+	if err != nil || !bytes.Equal(identity, after) {
+		return errors.New("Preview did not reuse sibling SSH transport")
+	}
+	if _, err := client.Stat("."); err != nil {
+		return errors.New("Preview close broke sibling SFTP")
+	}
+	if _, err := pty.Write([]byte("printf 'LBT173-%s\\n' 'PTY-OK'\n")); err != nil {
+		return errors.New("Preview close broke sibling PTY write")
+	}
+	marker := make(chan bool, 1)
+	go func() {
+		var body []byte
+		buf := make([]byte, 1024)
+		for len(body) < 32768 {
+			n, err := pty.Read(buf)
+			body = append(body, buf[:n]...)
+			if bytes.Contains(body, []byte("LBT173-PTY-OK")) {
+				marker <- true
+				return
+			}
+			if err != nil {
+				break
+			}
+		}
+		marker <- false
+	}()
+	select {
+	case ok := <-marker:
+		if !ok {
+			return errors.New("Preview sibling PTY marker missing; contents withheld")
+		}
+	case <-ctx.Done():
+		return errors.New("Preview sibling PTY timed out; contents withheld")
+	}
+	for _, bad := range []vmaccess.Target{
+		{LabInstanceID: "other", Generation: generation, VMKey: target.VMKey, ServerID: target.ServerID},
+		{LabInstanceID: target.LabInstanceID, Generation: generation + 1, VMKey: target.VMKey, ServerID: target.ServerID},
+		{LabInstanceID: target.LabInstanceID, Generation: generation, VMKey: "other", ServerID: target.ServerID},
+		{LabInstanceID: target.LabInstanceID, Generation: generation, VMKey: target.VMKey, ServerID: "missing-server"},
+	} {
+		if _, err := forwarder.DialTCP(ctx, bad, 3000); !errors.Is(err, preview.ErrVMUnreachable) {
+			return errors.New("KT Preview accepted wrong target")
+		}
+	}
+	for _, port := range []int{-1, 0, 22, 65536} {
+		if _, err := forwarder.DialTCP(ctx, target, port); !errors.Is(err, preview.ErrPortRejected) {
+			return errors.New("KT Preview accepted unsafe port")
+		}
+	}
+	if _, err := forwarder.DialTCP(ctx, target, 3001); !errors.Is(err, preview.ErrAppNotRunning) {
+		return errors.New("KT Preview closed app port classification failed")
+	}
+	if generation == 2 {
+		for _, stale := range []vmaccess.Target{
+			{LabInstanceID: target.LabInstanceID, Generation: 1, VMKey: target.VMKey, ServerID: oldServer},
+			{LabInstanceID: target.LabInstanceID, Generation: 1, VMKey: target.VMKey, ServerID: target.ServerID},
+		} {
+			if _, err := forwarder.DialTCP(ctx, stale, 3000); !errors.Is(err, preview.ErrVMUnreachable) {
+				return errors.New("KT Preview accepted stale generation after Reset")
+			}
+		}
+	}
+	fmt.Printf("KT Preview g%d: pinned management SSH direct-tcpip loopback:3000 HTTP200/exact-body twice, shared transport, PTY/SFTP isolation, target/port/refused guards PASS; bodies withheld\n", generation)
+	return save(fmt.Sprintf("PREVIEW_GENERATION%d_HTTP_SHARED_SSH_TARGET_PORT_ISOLATION_PASS", generation))
+}
+
+func previewSSHIdentity(ctx context.Context, access *vmaccess.Manager, target vmaccess.Target) ([]byte, error) {
+	s, err := access.OpenSession(ctx, target)
+	if err != nil {
+		return nil, errors.New("Preview SSH transport probe unavailable")
+	}
+	defer s.Close()
+	var output bytes.Buffer
+	err = s.Setup(ctx, func(raw *ssh.Session) error {
+		raw.Stdout = &output
+		raw.Stderr = io.Discard
+		return raw.Run("printf '%s' \"$SSH_CONNECTION\"")
+	})
+	if err != nil || output.Len() == 0 {
+		return nil, errors.New("Preview SSH transport probe failed")
+	}
+	return output.Bytes(), nil
+}
+
+func checkPreviewHTTP(conn net.Conn) error {
+	_ = conn.SetDeadline(time.Now().Add(10 * time.Second))
+	if _, err := fmt.Fprint(conn, "GET / HTTP/1.1\r\nHost: fixture\r\nConnection: close\r\n\r\n"); err != nil {
+		return errors.New("Preview HTTP write failed")
+	}
+	return validatePreviewHTTP(bufio.NewReader(conn))
+}
+
+func validatePreviewHTTP(reader *bufio.Reader) error {
+	response, err := http.ReadResponse(reader, nil)
+	if err != nil {
+		return errors.New("Preview HTTP response malformed; contents withheld")
+	}
+	defer response.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(response.Body, 128))
+	if err != nil || response.StatusCode != http.StatusOK || !bytes.Equal(body, []byte("LBT173-HTTP-OK")) {
+		return errors.New("Preview HTTP status/body mismatch; contents withheld")
+	}
+	return nil
+}
diff --git a/tools/ktcloud-d1-acceptance/preview_test.go b/tools/ktcloud-d1-acceptance/preview_test.go
new file mode 100644
index 0000000..f4d44fe
--- /dev/null
+++ b/tools/ktcloud-d1-acceptance/preview_test.go
@@ -0,0 +1,65 @@
+package main
+
+import (
+	"bufio"
+	"fmt"
+	"strings"
+	"testing"
+)
+
+func TestPreviewScopeRequiresExclusiveFreshTwoGenerations(t *testing.T) {
+	for _, tc := range []struct {
+		name                string
+		enabled, op02       bool
+		generations         int
+		recovery, wantError bool
+	}{
+		{"preview", true, false, 2, false, false},
+		{"mixed", true, true, 2, false, true},
+		{"single", true, false, 1, false, true},
+		{"recovery", true, false, 2, true, true},
+		{"default", false, true, 2, false, false},
+		{"recoveryDefault", false, false, 1, true, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := validatePreviewScope(tc.enabled, tc.op02, tc.generations, tc.recovery); (got != nil) != tc.wantError {
+				t.Fatalf("scope error=%v", got)
+			}
+		})
+	}
+}
+
+func TestPreviewCapabilityRequiresProductionAdvertisement(t *testing.T) {
+	for _, raw := range []string{`{}`, `{"payload":{"capabilities":["file-v1"]}}`, `malformed`} {
+		if requirePreviewCapability([]byte(raw)) == nil {
+			t.Fatal("missing capability accepted")
+		}
+	}
+	if err := requirePreviewCapability([]byte(`{"payload":{"capabilities":["preview-v1"]}}`)); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestPreviewHTTPRequiresExactResponse(t *testing.T) {
+	for _, tc := range []struct {
+		name, raw string
+		good      bool
+	}{
+		{"exact", "HTTP/1.1 200 OK\r\nContent-Length: 14\r\n\r\nLBT173-HTTP-OK", true},
+		{"truncated", "HTTP/1.1 200 OK\r\nContent-Length: 15\r\n\r\nLBT173-HTTP-OK", false},
+		{"wrongBody", "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nwrong", false},
+		{"status", "HTTP/1.1 503 Unavailable\r\nContent-Length: 14\r\n\r\nLBT173-HTTP-OK", false},
+		{"oversized", fmt.Sprintf("HTTP/1.1 200 OK\r\nContent-Length: 1024\r\n\r\n%s", strings.Repeat("x", 1024)), false},
+		{"malformed", "malformed", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			err := validatePreviewHTTP(bufio.NewReader(strings.NewReader(tc.raw)))
+			if (err == nil) != tc.good {
+				t.Fatalf("validation error=%v", err)
+			}
+			if err != nil && strings.Contains(err.Error(), "wrong") {
+				t.Fatal("response leaked into evidence")
+			}
+		})
+	}
+}
