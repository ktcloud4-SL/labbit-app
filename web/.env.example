# UI-only 개발은 기본적으로 Mock API를 사용합니다.
# 실제 Local Backend와 통합할 때만 http로 바꿉니다.
VITE_LABBIT_API_MODE=mock

# Vite dev server의 /api/v1 proxy 대상입니다.
# VITE_ 접두사를 사용하지 않아 Browser bundle에는 노출되지 않습니다.
LABBIT_DEV_BACKEND_URL=http://127.0.0.1:8080

# Optional PUBLIC URL. Approved script address (2026-10-20):
# https://raw.githubusercontent.com/ktcloud4-SL/labbit-app/e0caea4f3191e9109171c02581d498f48e4c9887/scripts/installer/install.sh
# The script is commit-pinned. Still review the script and release checksum
# before running it. Actual SaaS endpoint/VM installation acceptance is separate.
# The Web app is a Vite static bundle: set at IMAGE BUILD TIME, not in a Pod env.
# This is PUBLIC client-side data; HTTPS only, no credentials/query/fragment.
# Docker build support: --build-arg VITE_LABBIT_APPROVED_INSTALLER_URL=<approved-https-url>
# Published Web delivery supplies the approved URL; local builds may leave it empty.
# Never put enrollment tokens, connector credentials or sample/example.com URLs here.
VITE_LABBIT_APPROVED_INSTALLER_URL=
